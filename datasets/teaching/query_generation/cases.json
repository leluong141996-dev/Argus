{
  "task": "query_generation",
  "cases": [
    {
      "case_id": "qg-commute-001",
      "request": "How many weekday morning trips did our riders take last month?",
      "schema": {
        "metrics": ["trip_count", "revenue", "avg_duration"],
        "dimensions": ["day_type", "time_of_day", "city", "rider_id"],
        "filters": ["month", "city"]
      },
      "constraints": {"forbid_dimensions": ["rider_id"]},
      "rubric": {
        "criteria": "Counts trips, restricted to weekday mornings, for last month.",
        "must_include": [
          {"field": "metric", "value": "trip_count"},
          {"field": "filters.day_type", "value": "weekday"},
          {"field": "filters.time_of_day", "value": "morning"}
        ],
        "must_exclude": []
      },
      "expected": {
        "query": {
          "metric": "trip_count",
          "group_by": [],
          "filters": {"day_type": "weekday", "time_of_day": "morning", "month": "last_month"}
        }
      }
    },
